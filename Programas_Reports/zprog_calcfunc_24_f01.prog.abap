FORM f_soma  CHANGING p_gv_total.

  CALL FUNCTION 'ZF_SOMA_24'
    EXPORTING
      i_valor1 = p_val1
      i_valor2 = p_val2
    IMPORTING
      e_total  = gv_total.
  WRITE gv_total.

ENDFORM.
